{
  "name": "@shellwright/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "dependencies": {
    "@shellwright/config-schema": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@size-limit/preset-app": "11.1.6",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "jsdom": "25.0.1",
    "size-limit": "11.1.6",
    "typescript": "5.7.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "size-limit": [
    {
      "name": "studio initial bundle",
      "path": "dist/assets/*.js",
      "limit": "200 kB",
      "gzip": true
    }
  ]
}
