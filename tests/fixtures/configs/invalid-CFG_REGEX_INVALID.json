{
  "schemaVersion": 1,
  "app": {
    "name": "Bad Regex",
    "bundleId": "dev.shellwright.badregex",
    "initialUrl": "https://app.acme.com/",
    "allowedOrigins": ["https://app.acme.com"]
  },
  "navigation": {
    "drawer": {
      "enabled": true,
      "items": [
        {
          "id": "home",
          "label": "Home",
          "url": "/"
        },
        {
          "id": "orders",
          "label": "Orders",
          "url": "/orders"
        }
      ]
    }
  },
  "linkRules": [
    {
      "id": "broken",
      "pattern": "^https://app\\.acme\\.com(",
      "action": "internal"
    },
    {
      "id": "fallback",
      "pattern": ".*",
      "action": "externalBrowser"
    }
  ]
}
