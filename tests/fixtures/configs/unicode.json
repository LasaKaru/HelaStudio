{
  "$schema": "https://schema.shellwright.dev/appconfig/v1.json",
  "schemaVersion": 1,
  "app": {
    "name": "متجر أكمي للطلبات الكبير جدا",
    "bundleId": "com.acme.unicode",
    "initialUrl": "https://app.acme.com/",
    "allowedOrigins": ["https://app.acme.com"]
  },
  "navigation": {
    "tabBar": {
      "enabled": true,
      "items": [
        {
          "id": "home",
          "label": "🏠 الرئيسية",
          "url": "/"
        },
        {
          "id": "orders",
          "label": {
            "default": "注文",
            "ar": "الطلبات",
            "en-GB": "Orders"
          },
          "url": "/orders"
        },
        {
          "id": "combining",
          "label": "Café ☕",
          "url": "/cafe"
        },
        {
          "id": "cjk",
          "label": "설정 ⚙️",
          "url": "/settings"
        }
      ]
    }
  },
  "linkRules": [
    {
      "id": "fallback",
      "pattern": ".*",
      "action": "externalBrowser"
    }
  ]
}
