<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for allowBackup. Same reasoning: a web session is not
  something to copy between devices or into a cloud backup on the user's behalf.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
