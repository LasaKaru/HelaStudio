{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".editorconfig",
    "tsconfig.base.json"
  ],
  "tasks": {
    "generate": {
      "inputs": [
        "schema/**"
      ],
      "outputs": [
        "src/generated/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!coverage/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "size": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    }
  }
}
