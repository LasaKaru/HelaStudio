{
  "name": "@shellwright/config-schema",
  "version": "0.1.0",
  "description": "appconfig.json v1 — schema, validation, canonicalisation, hashing, and migration.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/appconfig.v1.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-types.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@noble/hashes": "1.7.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "fast-check": "3.23.2",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
