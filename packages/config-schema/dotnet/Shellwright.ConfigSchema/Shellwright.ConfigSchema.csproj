<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shellwright.ConfigSchema</RootNamespace>
    <AssemblyName>Shellwright.ConfigSchema</AssemblyName>
    <IsPackable>true</IsPackable>
    <Description>appconfig.json v1 — schema, validation, canonicalisation, hashing, and migration.</Description>
    <!-- Canonicalisation NFC-normalises every string, and String.Normalize is a
         silent no-op for non-ASCII under globalization-invariant mode. Leaving
         the repository default on would make "cafe" with a combining accent hash
         differently here than in the TypeScript engine, so the build cache would
         miss and the two validators would disagree. Anything that consumes this
         library must also set this to false. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Blake3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The schema is the same file the TypeScript side loads. One copy, one truth. -->
    <EmbeddedResource Include="../../schema/appconfig.v1.json" LogicalName="appconfig.v1.json" />
  </ItemGroup>

</Project>
