// swift-tools-version: 6.0
import PackageDescription

// The iOS shell is split in two on purpose.
//
// `ShellCore` is pure Swift over Foundation: the config model, the two-phase
// parse, link routing, regex safety, the origin allowlist, the user agent, and
// the offline page. It imports no UIKit and no WebKit, so it builds and its
// tests run anywhere — including Linux CI, and including a developer's machine
// that is not a Mac.
//
// `ShellApp` is the UIKit and WebKit host. It can only build on Apple platforms,
// and is driven from the Xcode project generated by `project.yml`.
//
// This mirrors the Android decision to write `OriginAllowlist` against
// `java.net.URI` rather than `android.net.Uri`: the parts most worth testing are
// deliberately kept free of the platform.
let package = Package(
    name: "{{ projectName }}",
    platforms: [.iOS(.v15), .macOS(.v13)],
    products: [
        .library(name: "ShellCore", targets: ["ShellCore"]),
    ],
    targets: [
        .target(
            name: "ShellCore",
            // ExistentialAny makes `any Decoder` explicit at every boundary,
            // which is worth the noise. InternalImportsByDefault is not enabled:
            // it would force `public import Foundation` across the module for no
            // benefit in a package this size.
            swiftSettings: [.enableUpcomingFeature("ExistentialAny")]
        ),
{{~ if includeTests ~}}
        .testTarget(
            name: "ShellCoreTests",
            dependencies: ["ShellCore"],
            // The shared fixture corpus lives outside this package, so the tests
            // walk up to it rather than copying it. Both shells and both
            // validators must read the same bytes.
            swiftSettings: [.enableUpcomingFeature("ExistentialAny")]
        ),
{{~ end ~}}
    ]
)
